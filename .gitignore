# Environment / secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/
website-app/node_modules/
website-app/apps/*/node_modules/

# Next.js
.next/
out/
*.tsbuildinfo

# Vite site build
website-app/dist/
website-app/apps/*/dist/

# Expo (mobile app lives at website-app/apps/mobile)
website-app/apps/*/.expo/
website-app/apps/*/web-build/
website-app/apps/*/android/
website-app/apps/*/ios/

# Local database dumps / source archives (contain real data, keep local)
backups/

# Generated migration snapshots/reports (may contain passwords, PII, QR images)
scripts/migrate-firebase/inspect-out/
scripts/migrate-firebase/*-report*.json
scripts/migrate-firebase/migration-report*.json
scripts/migrate-firebase/migration-credentials.local.json

# Generated mobile builds served from the site (rebuild from apps/mobile)
public/downloads/*.apk
public/downloads/*.ipa
public/downloads/*.sha256
website-app/public/downloads/*.sha256
# Generated desktop builds served from the site (rebuild via desktop-app-exe)
public/downloads/*.exe
public/downloads/*.AppImage
public/downloads/*.deb
public/downloads/*.dmg

# Logs
*.log
npm-debug.log*
.vercel
.env*

# local build output (root copy)
dist/
