# Fimto Concrete ERP — API runtime image for the free Render tier.
#
# The free instance has 512 MB of RAM, and `next build` for this app peaks near
# 1 GB, so the build is killed on that host. The server bundle is therefore
# produced on a full-RAM machine (bash ~/.local/bin/fimto-publish-api) and
# published as a GitHub Release asset. This image does nothing but download and
# unpack it: no npm, no build step, nothing that needs memory.
#
#   FROM  node:22-slim (stock)
#     ↓   download + unpack the published bundle  (~22 MB, via node's fetch,
#         so no extra package has to be installed)
#   CMD   node server.js
FROM node:22-bookworm-slim

WORKDIR /app

ARG BUNDLE_URL=https://github.com/engahmedabdoualyan-max/concreete/releases/download/api/fimto-api.tgz
ENV BUNDLE_URL=$BUNDLE_URL

# Cache-buster: bump on every bundle publish, otherwise Render reuses the
# cached download layer and keeps serving the previous bundle even though the
# release asset changed (same URL = same layer = stale deploy).
ARG CACHE_BUST=20261008-065235

RUN echo "bundle cache-bust: $CACHE_BUST" \
 && node -e "require('fs');fetch(process.env.BUNDLE_URL).then(r=>{if(!r.ok)throw new Error('download failed: '+r.status);return r.arrayBuffer()}).then(b=>{require('fs').writeFileSync('/tmp/bundle.tgz',Buffer.from(b));console.log('downloaded '+b.byteLength+' bytes')}).catch(e=>{console.error(e.message);process.exit(1)})" \
 && tar -xzf /tmp/bundle.tgz -C /app \
 && rm -f /tmp/bundle.tgz \
 && test -f /app/server.js \
 && echo "bundle unpacked: $(du -sh /app | cut -f1)"

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=10000

EXPOSE 10000
CMD ["node", "server.js"]
