{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --workspaces --if-present --ignore-scripts",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- 'website-app/apps/mobile/**' 'website-app/**' || echo 'mobile-or-site-changed'",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "env": {
    "DATABASE_URL": "@database-url",
    "JWT_SECRET": "@jwt-secret",
    "JWT_EXPIRES_IN": "15m",
    "REFRESH_TOKEN_EXPIRES_IN": "30d"
  }
}