# ── FimtoSoft Concrete ERP — Environment Configuration ──────────────────────
# Copy to `.env` and fill in the LIVE Supabase values from the project
# dashboard: Project Settings → Database → Connection string → "URI" (pooled).

# ── Database (Supabase pooled connection) ───────────────────────────────────
# Use the TRANSACTION POOLER connection string (port 6543):
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── JWT (must match the SUPABASE_JWT_SECRET from Dashboard → Settings → API) ─
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Server-to-server signing / integration secrets (required in production)
#WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-secret
#FLEET_GPS_WEBHOOK_KEY=replace-with-a-long-random-secret
#QR_SECRET=replace-with-a-long-random-secret

# Optional legacy compatibility only; keep false/unset in production.
#LEGACY_API_ENABLED=false

# ── Realtime / Socket.io ────────────────────────────────────────────────────
REALTIME_PORT=4000
SOCKET_CORS_ORIGIN=*

# ── Customer Notifications (Epic 1) ───────────────────────────────────────────
# Provider: log | msegat | unifonic | twilio | whatsapp
# "log" = dev default (console + audit_logs, zero SMS cost)
NOTIFY_PROVIDER=log

# Msegat (Saudi SMS gateway) — https://www.msegat.com
#MSEGAT_USERNAME=
#MSEGAT_API_KEY=
#MSEGAT_SENDER=FIMTO

# Unifonic (MENA SMS gateway) — https://www.unifonic.com
#UNIFONIC_APPSID=
#UNIFONIC_SENDER=FIMTO

# Twilio (global SMS fallback) — https://www.twilio.com
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_FROM=

# WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_ID=

# ── Customer Portal magic links (Epic 2) ─────────────────────────────────────
# Public base URL embedded in share links (hash route of the website SPA)
#PUBLIC_PORTAL_BASE_URL=https://concrete.fimtosoft.com/#/track

# ── Drum telematics ingest (Epic 5) ───────────────────────────────────────────
# Shared secret for probes / GPS vendors posting to /api/v1/telematics/ingest
#TELEMATICS_INGEST_KEY=replace-with-a-long-random-secret

# ── External accounting integrations (Epic 6) ─────────────────────────────────
# AES-256-GCM key for stored provider credentials (64 hex chars = 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#INTEGRATION_CRYPTO_KEY=replace-with-64-hex-chars

# ── Enterprise SSO + public links (Epic 11) ───────────────────────────────────
# Base URL used for the OIDC callback + magic portal links
#PUBLIC_APP_BASE_URL=https://concrete.fimtosoft.com

# ── Tree-plane sync (Epic 13) ─────────────────────────────────────────────────
# Shared secret for field-plane order import (POST /api/v1/tree-sync/orders)
#TREE_SYNC_KEY=replace-with-a-long-random-secret
# Firebase Admin SDK (PG → tree mirror). Absent = mirror silently skipped.
# JSON of the service-account key (single line):
#FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
