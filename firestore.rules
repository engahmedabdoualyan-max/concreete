rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: app-level auth (login stored in DB, not Firebase Auth)
    match /users/{username} {
      allow read, write: if true;
    }

    // Per-user data documents: userData/{userId}/{collectionName}/data
    match /userData/{userId}/{collectionName}/data {
      allow read, write: if true;
    }

    // Top-level per-user document (storage quota / usage tracking)
    match /userData/{userId} {
      allow read, write: if true;
    }

    // Company app-tree (app login accounts per company)
    match /companyTrees/{companyUsername} {
      allow read, write: if true;
    }

    // Console admin site-level config (custom sections + uploaded images metadata)
    match /siteConfig/{docId} {
      allow read, write: if true;
    }

    // Uploaded console images (compressed base64, one doc per image)
    match /media/{mediaId} {
      allow read, write: if true;
    }
  }
}
