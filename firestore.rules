rules_version = '2';

// Production ruleset: direct anonymous/browser access is intentionally denied.
// The server API must use Firebase Admin (or another trusted backend) after
// verifying the user's tenant and role. Expected custom claims:
//   tenantId: string, role: string, username?: string
// Admin roles: SUPER_ADMIN, OWNER, ADMIN.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('SUPER_ADMIN') || hasRole('OWNER') || hasRole('ADMIN');
    }

    function sameTenant(tenantId) {
      return signedIn() && request.auth.token.tenantId == tenantId;
    }

    // App identities are server-owned. No client password/hash reads.
    match /users/{username} {
      // User documents contain credential material; no browser may read them.
      allow read, write: if isAdmin();
    }

    // Operational caches contain cross-company records and the historical
    // userId is not a tenant UUID. Keep them server-only until the API owns
    // every read/write; admin clients are the only temporary browser exception.
    match /userData/{userId} {
      allow read, write: if isAdmin();

      match /{collectionName}/data {
        allow read, write: if isAdmin();
      }
    }

    // Company/account trees and subscriptions are Console/server owned.
    match /companyTrees/{companyUsername} {
      allow read, write: if isAdmin();
    }

    // siteConfig also contains OTP hashes; never expose it to browsers.
    match /siteConfig/{docId} {
      allow read, write: if isAdmin();
    }

    // Media documents may contain operational/customer data; keep them
    // server/admin-only until a public asset policy is explicitly designed.
    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
