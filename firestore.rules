rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  SECURE RULESET (current live target)
//  Clients authenticate via anonymous Firebase auth; every read/write
//  requires a valid auth token. `media` writes are allowed for
//  authenticated clients because the Console admin uploads section
//  images directly through the SDK (dbimg://id payloads).
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // App users (login profiles). Read/write requires auth.
    match /users/{username} {
      allow read, write: if request.auth != null;
    }

    // Per-user ERP data: userData/{userId}/{collectionName}/data
    match /userData/{userId} {
      allow read, write: if request.auth != null;

      match /{collectionName}/data {
        allow read, write: if request.auth != null;
      }
    }

    // Company app-tree (app login accounts per company)
    match /companyTrees/{companyUsername} {
      allow read, write: if request.auth != null;
    }

    // Console site-level config + OTP hash records (public READ needed for logos/images)
    match /siteConfig/{docId} {
      allow read, write: if request.auth != null;
    }

    // Uploaded console images metadata (base64 payloads) — public read for display.
    // Console writes them directly (SDK), so allow authenticated writes.
    match /media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else: denied by default.
  }
}